# --- Client (Vite) ---
# Safe to expose in the browser. Never put service-role keys here.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Optional analytics (public IDs only)
# VITE_AMPLITUDE_API_KEY=
# VITE_GA_MEASUREMENT_ID=

# --- Edge function secrets (set via `supabase secrets set`, not in Vite) ---
# SUPABASE_SERVICE_ROLE_KEY=   # server only
# APP_URL=http://localhost:8080
# ALLOWED_REDIRECT_ORIGINS=http://localhost:8080,https://your-production-domain
# OAUTH_STATE_SECRET=          # HMAC secret for Google Calendar OAuth state (falls back to GOOGLE_CLIENT_SECRET)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LOVABLE_API_KEY=             # optional; powers smart-input + life-replay
